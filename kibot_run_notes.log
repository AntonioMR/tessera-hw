        mirror_pcb_text: true
        title: 'Assembly'
        sheet: Bottom Assembly (Scale 1:1)
        sheet_reference_color: '#000000'
        colored_holes: true
        holes_color: "#FFFFFF"
        layers:
          - layer: Edge.Cuts
            color: '#000000'
          - layer: B.Cu
            color: '#D5DBF4'
          - layer: B.Mask
            color: '#B9B9B9'
          - layer: B.Paste
